# GEMINI_API_KEY: Usada exclusivamente no servidor / Vercel Serverless Functions
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (Opcional): Sobrescreve a descoberta automática de modelo do Gemini
# Se omitida, o sistema descobre automaticamente o melhor modelo "flash" ativo.
# GEMINI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

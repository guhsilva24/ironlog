# GEMINI_API_KEY: Usada no backend / serverless functions (Node.js / Express / Vercel Serverless)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Necessária para o Vite em builds SPA de produção (como Vercel)
# Cadastre esta variável no painel do Vercel (Settings > Environment Variables)
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
